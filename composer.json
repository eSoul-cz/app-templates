{
    "name": "esoul-cz/app-templates",
    "description": "Layered source of the eSoul application templates and the builder that assembles the template variants.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "esoul-cz/guidelines": "^0.4",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/filesystem": "^7.3 || ^8.0",
        "symfony/finder": "^7.3 || ^8.0",
        "symfony/process": "^7.3 || ^8.0"
    },
    "require-dev": {
        "esoul-cz/coding-standard": "^0.1",
        "phpstan/extension-installer": "^1",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "ESoul\\AppTemplates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ESoul\\AppTemplates\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/templates"
    ],
    "scripts": {
        "post-update-cmd": [
            "esoul-guidelines sync"
        ],
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
