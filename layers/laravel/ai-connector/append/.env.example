
# --- AI connector (a client connects their own Claude or ChatGPT; see "AI connector" in the README) ---
# Global switch. Off (the default): /mcp, the OAuth endpoints and the discovery documents answer 404.
AI_CONNECTOR_ENABLED=false
# Tool calls per minute and per access token.
AI_CONNECTOR_RATE_LIMIT=60
# Where the assistants send the user back after the approval (comma separated, https:// prefixes). Empty = Claude and ChatGPT.
AI_CONNECTOR_REDIRECT_DOMAINS=
# Passport signing keys: a DEPLOY SECRET (1Password -> Komodo), never committed. Generate once per environment with
# `php artisan passport:keys` and put the CONTENT of the two files here (multi-line values in double quotes, newlines as \n).
# Empty keys = Passport looks for storage/oauth-private.key and storage/oauth-public.key (gitignored).
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
