
# --- CMS (headless: the Astro frontend in ../frontend builds from GET /cms-api/v1/export) ---
# Bearer token of the export, read by the frontend build (= CMS_API_TOKEN there). Empty = export disabled (404).
CMS_EXPORT_TOKEN=
# IPs / CIDRs (comma separated) allowed to call /cms-api (build agent and Jenkins callback). Empty = no restriction.
CMS_API_ALLOWED_IPS=
# Directory of the public media copy that the web server serves at /_cms/. Empty = storage/app/cms-public.
CMS_PUBLIC_MEDIA_ROOT=

# Publish button -> Jenkins job `buildWithParameters` (parameter CMS_PUBLISH_ID).
CMS_JENKINS_JOB_URL=
CMS_JENKINS_USER=
CMS_JENKINS_API_TOKEN=
# Bearer token Jenkins uses to report the result to POST /cms-api/v1/publishes/{id}/status.
CMS_JENKINS_CALLBACK_TOKEN=
# A publish without a result after this many minutes is marked failed (the callback is best effort).
CMS_PUBLISH_TIMEOUT=30
